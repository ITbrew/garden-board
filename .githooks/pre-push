#!/bin/sh
#
# The whole tree, and only the checks that finish.
#
# This ran the full 85-test suite until 2026-09-08 and it never once completed. Each test starts a
# real Garden with a real ConPTY and they run one at a time on purpose, which is around 25 minutes,
# and twice in one day something ordinary killed the shell holding it: a session restart, then the
# owner taking the app offline. Both times the suite kept running orphaned, nothing was pushed, and
# the only visible effect was the owner being told to wait for something that was never going to
# finish. A gate that never completes protects nothing.
#
# So the suite is no longer attached to a push. It is run deliberately at a stopping point and its
# result reported, which is the only way a 25-minute run has ever actually been read. What is left
# here finishes in seconds and therefore actually runs.
#
# `git push --no-verify` skips it. That is a legitimate thing to do for a documentation-only push
# and a bad thing to do out of habit.
#
# Not a call to .githooks/pre-commit, which would look tidier and be wrong: that one scans what is
# staged, and at push time nothing is. The whole tree is the right scope here.
#
# Nothing here starts a Garden, so there is no GARDEN_PORT to strip any more. That protection moved
# to wherever the suite is actually run. See docs/canonical/14-how-tests-are-run.md.

set -e
cd "$(git rev-parse --show-toplevel)"

fail=0
step() {
  printf '  %-28s' "$1"
  shift
  if out=$("$@" 2>&1); then
    echo "ok"
  else
    echo "FAILED"
    echo "$out" | sed 's/^/    /'
    fail=1
  fi
}

echo "pre-push:"

# Two PCs push to one branch. Git refuses a non-fast-forward push on its own, but only after the
# checks below have run and with a message about "fetch first" that says nothing about the other
# PC. So: fetch now, and if the remote branch has commits this checkout does not, stop here and
# say what to do. This is the "pull before push" rule as a refusal rather than a memory.
printf '  %-28s' "on top of origin"
remote=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo origin/master)
if git fetch --quiet origin 2>/dev/null && ! git merge-base --is-ancestor "$remote" HEAD 2>/dev/null; then
  echo "FAILED"
  echo "    $remote has commits this checkout does not (the other PC pushed)."
  echo "    Run: git pull --rebase origin ${remote#origin/}   then push again."
  echo "    Only unpushed commits get rebased; if git asks for a force push, stop and ask."
  fail=1
else
  echo "ok"
fi
step "typecheck" npm run --silent typecheck
step "no test touches the board" node scripts/check-no-live-board.mjs
step "no credential in the tree" node scripts/check-no-secrets.mjs --all

printf '  %-28s' "every script parses"
bad=""
for f in $(git ls-files '*.mjs'); do
  if ! err=$(node --check "$f" 2>&1); then
    bad="$bad\n    $f\n$(echo "$err" | sed 's/^/      /')"
  fi
done
if [ -z "$bad" ]; then echo "ok"; else echo "FAILED"; printf "%b\n" "$bad"; fail=1; fi

if [ "$fail" -ne 0 ]; then
  echo
  echo "push refused. Fix the above."
  exit 1
fi

echo
echo "pre-push: ok. The suite is not run here; run it at a stopping point:"
echo "  node scripts/run-suite.mjs"
exit 0
