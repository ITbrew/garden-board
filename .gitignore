node_modules/
dist/
*.log

# Screenshot output. Regenerate with `node scripts/capture.mjs`.
docs/shots/

# Local editor noise
.vscode/
.idea/

# Per-machine Claude Code settings, and the claim files sessions leave for each other while they
# work. Both are about this checkout on this machine rather than about the project.
.claude/settings.local.json
.claude/sessions/

# Launcher output. One file per half, plus the previous run kept alongside it.
logs/

# TypeScript's incremental build cache. Output, and it changes on every build, so it was adding a
# meaningless line to every diff.
*.tsbuildinfo

# A card's scratch copy of server/src, so a change could be photographed without saving under
# server/src and restarting the watcher. Its own README says to delete it once the real batch lands.
.scratch-server/

# Environment files. Nothing here needs one today, and this is the rule that matters before that
# changes rather than after.
.env
.env.*
!.env.example
*.pem
*.key

# Backups of build output, which a card sometimes makes before rebuilding. Same status as
# dist/ itself: regenerated by `npm run build`, never worth committing, and never worth asking
# the owner about.
dist.bak-*/
